{
  "rules": {
    ".read": false,
    ".write": false,

    "equipo": {
      ".read": "auth != null && root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
      "$correo": {
        ".write": "auth != null && root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).child('admin').val() == true",
        ".validate": "newData.hasChildren(['email', 'admin']) && newData.child('email').isString() && newData.child('email').val().toLowerCase().replace('.', ',') == $correo && newData.child('admin').isBoolean()"
      }
    },

    "dispositivo": {
      ".read": "auth != null && (data.val() == auth.uid || (root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))",
      ".write": "auth != null && root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).child('admin').val() == true",
      ".validate": "newData.isString()"
    },

    "solicitudes": {
      ".read": "auth != null && root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).child('admin').val() == true",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || (root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).child('admin').val() == true))",
        ".validate": "newData.hasChildren(['codigo', 'ts']) && newData.child('codigo').isString() && newData.child('codigo').val().matches(/^[0-9]{6}$/)"
      }
    },

    "robot": {
      "estado": {
        ".read": "auth != null && root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
        ".write": "auth != null && auth.uid == root.child('dispositivo').val()"
      },
      "eventos": {
        ".read": "auth != null && root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
        ".write": "auth != null && auth.uid == root.child('dispositivo').val()"
      },
      "eventos_n": {
        ".read": "auth != null && auth.uid == root.child('dispositivo').val()",
        ".write": "auth != null && auth.uid == root.child('dispositivo').val()"
      },
      "respuesta": {
        ".read": "auth != null && root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
        ".write": "auth != null && auth.uid == root.child('dispositivo').val()"
      },
      "ordenes": {
        ".read": "auth != null && auth.uid == root.child('dispositivo').val()",
        "comando": {
          ".read": "auth != null && root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
          ".write": "auth != null && root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
          ".validate": "newData.hasChildren(['cmd', 'n', 'por']) && newData.child('cmd').isString() && newData.child('cmd').val().matches(/^(RECOGER|REPOSO|PING|LIMPIEZA_ON|LIMPIEZA_OFF)$/) && newData.child('n').isNumber()"
        },
        "config": {
          ".read": "auth != null && root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
          ".write": "auth != null && (auth.uid == root.child('dispositivo').val() || (root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))"
        },
        "secretos": {
          ".write": "auth != null && (auth.uid == root.child('dispositivo').val() || (root.child('equipo').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))"
        }
      }
    }
  }
}
