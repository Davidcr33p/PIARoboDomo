{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "raulcito-bracito",
    "public": "pagina_web",
    "ignore": ["**/.*"],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  }
}
